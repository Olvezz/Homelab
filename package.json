{
  "name": "homelab-desktop",
  "version": "0.9.10",
  "description": "HomeLab Desktop: Proxmox y paneles de servicios en una sola ventana",
  "main": "./out/main/index.js",
  "author": "Olvezz",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "themes": "node scripts/sync-themes.mjs",
    "icons": "node scripts/build-icons.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "release": "npm run clean && npm run build && electron-builder --win --publish always",
    "format": "prettier --write .",
    "beta": "node scripts/beta.mjs",
    "licenses": "node scripts/licenses.mjs",
    "bump": "npm version patch --no-git-tag-version",
    "dist": "npm run clean && npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "lucide-react": "^1.49.0",
    "prettier": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "selfsigned": "^5.5.0",
    "simple-icons": "^16.33.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
